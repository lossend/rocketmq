          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m12" value="transport-layer reconnect&#xa;(one replay only)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.3875;entryX=1;entryY=0.425;" edge="1" parent="1" source="act5" target="act5">
