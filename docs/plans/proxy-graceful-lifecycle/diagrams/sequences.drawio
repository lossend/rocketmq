        </mxCell>
        <mxCell id="m0" value="connect" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.072;entryX=0;entryY=0.0;" edge="1" parent="1" source="client" target="act3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m1" value="new Channel" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0;exitY=0.0446;entryX=1;entryY=0.0;" edge="1" parent="1" source="act3" target="act4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m2" value="onChannelActive():&#xa;assign lease 270-330s&#xa;(jitter, monotonic deadline)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.0467;entryX=1;entryY=0.0748;" edge="1" parent="1" source="act4" target="act4">
