          <mxGeometry x="45" y="380" width="10" height="290" as="geometry"/>
        </mxCell>
        <mxCell id="act2" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="adapters">
          <mxGeometry x="45" y="620" width="10" height="410" as="geometry"/>
        </mxCell>
        <mxCell id="act3" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="runtime">
          <mxGeometry x="45" y="90" width="10" height="1120" as="geometry"/>
        </mxCell>
        <mxCell id="act4" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="gate">
          <mxGeometry x="45" y="570" width="10" height="820" as="geometry"/>
        </mxCell>
        <mxCell id="m0" value="shutdown(SIGTERM_FALLBACK)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.0629;entryX=0;entryY=0.0;" edge="1" parent="1" source="term" target="act3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m1" value="beginDrain(SIGTERM_FALLBACK)&#xa;(join existing DrainRun if present)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.0446;entryX=0;entryY=0.0;" edge="1" parent="1" source="act3" target="act0">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m2" value="DrainRun (session, drainFuture)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=1;entryY=0.0893;" edge="1" parent="1" source="act0" target="act3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m3" value="CAS AtomicReference&lt;StopRun&gt;&#xa;(first winner constructs StopRun)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.1339;entryX=1;entryY=0.1607;" edge="1" parent="1" source="act3" target="act3">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="510" y="280"/><mxPoint x="510" y="310"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m4" value="stopDeadline =&#xa;min(now+jvmTimeout,&#xa;(preStopDeadline+jvmTimeout)-now)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.1964;entryX=1;entryY=0.2232;" edge="1" parent="1" source="act3" target="act3">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="510" y="350"/><mxPoint x="510" y="380"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m5" value="escalateForStop(stopDeadline)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.2589;entryX=0;entryY=0.0;" edge="1" parent="1" source="act3" target="act1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m6" value="cancel pending lb/lease&#xa;scheduled timers (phase generation)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.1724;entryX=1;entryY=0.2759;" edge="1" parent="1" source="act1" target="act1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="870" y="470"/><mxPoint x="870" y="500"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m7" value="fast-forward state machine&#xa;(READY/QUIESCING/MIGRATING -&gt; DRAINING,&#xa;or STARTING -&gt; FORCE_DRAINING)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.4138;entryX=1;entryY=0.5172;" edge="1" parent="1" source="act1" target="act1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="870" y="540"/><mxPoint x="870" y="570"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m8" value="closeAdmission() immediately&#xa;(no 60s / 420s wait)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.6552;entryX=0;entryY=0.0;" edge="1" parent="1" source="act1" target="act4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m9" value="freeze both protocols&#xa;(same fan-out as normal drain)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.8276;entryX=0;entryY=0.0;" edge="1" parent="1" source="act1" target="act2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m10" value="escalateForStop future completes&#xa;(freeze issued)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=1;entryY=0.5179;" edge="1" parent="1" source="act1" target="act3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m11" value="await accepted_inflight_zero&#xa;within min(drainDeadline, stopDeadline)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.5625;entryX=1;entryY=0.5893;" edge="1" parent="1" source="act3" target="act3">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="510" y="760"/><mxPoint x="510" y="790"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="note12" value="alt: drained before stopDeadline" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="470" y="810" width="254" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="m13" value="StopRun succeeds normally" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.6786;entryX=1;entryY=0.7054;" edge="1" parent="1" source="act3" target="act3">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="510" y="890"/><mxPoint x="510" y="920"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="note14" value="else: stopDeadline exceeded" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="470" y="940" width="219" height="40" as="geometry"/>
        </mxCell>
