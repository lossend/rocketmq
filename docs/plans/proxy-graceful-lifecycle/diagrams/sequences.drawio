          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="note19" value="A second GO_AWAY on the replayed attempt WOULD fail the&#xa;client - this path buffers exactly one migration, never&#xa;correctness." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
