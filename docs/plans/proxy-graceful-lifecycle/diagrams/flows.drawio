          <mxGeometry x="250" y="1300" width="100" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="note7_1" value="On any send-SLO, connection-storm, or&#xa;provider-detach anomaly during rollout:&#xa;pause immediately, keep READY Pods,&#xa;roll back only to a Helm revision that&#xa;is binary+probe+PreStop compatible.&#xa;Never auto-rollback." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;" vertex="1" parent="1">
