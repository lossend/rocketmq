        <mxCell id="fatal5" value="/ready -&gt; 503&#xa;/ready-for-traffic -&gt; 503&#xa;(immediate fail-close, both endpoints)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="0" y="790" width="344" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="threshold5" value="consecutive failures&#xa;&gt;= dependencyFailureThreshold?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="420" y="800" width="250" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="failopen5" value="/ready -&gt; still 200 (fail-open)&#xa;/ready-for-traffic -&gt; 503 (fail-close)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="140" y="930" width="344" height="70" as="geometry"/>
