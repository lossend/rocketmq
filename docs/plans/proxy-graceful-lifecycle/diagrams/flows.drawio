  <diagram id="fl2" name="Single clock budget timeline (spec §3.6)">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="start2" value="start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="120" y="0" width="100" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="t0" value="T0 = beginDrain()&#xa;enter QUIESCING, readiness fails,&#xa;EndpointSlice / NLB detach starts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="20" y="80" width="304" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="t60" value="+60s -&gt; lbCutoff&#xa;reject any new business transport&#xa;as late from here on" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="20" y="200" width="304" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="t420" value="+420s (60+330+30) -&gt; migrationCutoff&#xa;close admission if not already closed,&#xa;freeze intake" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="0" y="370" width="344" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="t450" value="+450s -&gt; drainHardDeadline&#xa;must reach DRAINED by here or force" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="240" y="530" width="320" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="t480" value="+480s -&gt; preStopWait&#xa;PreStop / HTTP drain waiter absolute cap" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="220" y="640" width="360" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="t540" value="+540s -&gt; podGrace&#xa;terminationGracePeriodSeconds" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="260" y="750" width="272" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="t600" value="&gt;=600s -&gt; rollout step budget&#xa;(next Pod replacement not started before this)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="200" y="850" width="408" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="stop2" value="stop" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="350" y="960" width="100" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="note2_1" value="Named budgets (must share one config source):&#xa;D_provider_keep &gt;= D_app_hard + D_skew + D_safety&#xa;D_dependency_wait + D_app_hard + D_skew + D_safety &lt;= D_provider_keep&#xa;terminationGracePeriodSeconds &gt;= D_prestop + D_process_stop + D_safety&#xa;&#xa;All of these are DERIVED from one config source,&#xa;never re-defaulted independently in Helm / app / PreStop / supervisor." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;" vertex="1" parent="1">
          <mxGeometry x="360" y="330" width="530" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="e0" value="" style="html=1;rounded=0;" edge="1" parent="1" source="start2" target="t0">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="170" y="40"/><mxPoint x="170" y="60"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e1" value="" style="html=1;rounded=0;" edge="1" parent="1" source="t0" target="t60">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="170" y="170"/><mxPoint x="170" y="190"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e2" value="" style="html=1;rounded=0;" edge="1" parent="1" source="t60" target="t420">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="170" y="290"/><mxPoint x="170" y="360"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e3" value="" style="html=1;rounded=0;" edge="1" parent="1" source="t420" target="t450">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="290" y="460"/><mxPoint x="290" y="520"/></Array></mxGeometry>
