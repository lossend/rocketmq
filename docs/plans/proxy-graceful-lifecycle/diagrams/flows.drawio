        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="fl3" name="Remoting beforeEnqueue admission decision (spec §9.4)">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="start3" value="start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="260" y="0" width="100" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="lookup3" value="processor lookup" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="220" y="80" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="shutdown3" value="already in global shutdown?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="190" y="170" width="229" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="existing3" value="return existing&#xa;versioned GO_AWAY behavior" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="0" y="290" width="248" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="stopA3" value="stop" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="70" y="410" width="100" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="classify3" value="classify request&#xa;(producer send code? clientVersion? invocation mode)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="270" y="290" width="456" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="lease3" value="lease not expired&#xa;AND gate OPEN?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="390" y="390" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="accepted3" value="accepted&#xa;(bind RemotingSendLifecycle(permit))" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="180" y="520" width="328" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="expired3" value="lease expired AND&#xa;clientVersion &gt; V5_3_1 AND&#xa;not oneway?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="530" y="510" width="222" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="goaway_a3" value="write GO_AWAY&#xa;(do not dispatch to Broker)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="370" y="640" width="256" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="draining3" value="DRAINING or past lbCutoff&#xa;AND clientVersion &gt; V5_3_1?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="650" y="640" width="229" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="goaway_b3" value="write GO_AWAY&#xa;(do not dispatch)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="490" y="760" width="180" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="legacy3" value="legacy client past cutoff?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="690" y="750" width="222" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="busy3" value="write SYSTEM_BUSY&#xa;&quot;[PROXY_DRAINING] retry another proxy&quot;&#xa;close channel, count as degraded" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
