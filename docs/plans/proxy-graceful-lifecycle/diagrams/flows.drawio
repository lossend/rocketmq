<mxfile host="drawio">
  <diagram id="fl1" name="Unique shutdown order - 4 milestones per protocol (spec §3.4)">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="start1" value="start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="210" y="0" width="100" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="quiescing1" value="QUIESCING entered&#xa;(gate stays OPEN)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="170" y="80" width="180" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="fork1a" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="320" y="180" width="200" height="10" as="geometry"/>
        </mxCell>
        <mxCell id="grpc_mig" value="gRPC: migration_started&#xa;(initiateServerDrain() -&gt; Server.shutdown()&#xa;triggers built-in double GOAWAY, non-blocking)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="0" y="230" width="408" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="rmt_mig" value="Remoting: migration_started&#xa;(GO_AWAY per clientVersion x invocation mode,&#xa;or close idle channel)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="430" y="230" width="400" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="join1a" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="320" y="350" width="200" height="10" as="geometry"/>
        </mxCell>
        <mxCell id="fork1b" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="320" y="400" width="200" height="10" as="geometry"/>
        </mxCell>
        <mxCell id="grpc_nnw" value="gRPC: wait for no_new_work_reached&#xa;predicate from Step-1 spike&#xa;(double GOAWAY itself, or bounded&#xa;quiet window if new streams still possible)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="30" y="450" width="384" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="rmt_nnw" value="Remoting: wait for no_new_work_reached&#xa;(freezeRequestIntake() barrier crossed)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="430" y="470" width="352" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="join1b" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="320" y="590" width="200" height="10" as="geometry"/>
        </mxCell>
        <mxCell id="admission_closed" value="last protocol to reach&#xa;no_new_work_reached triggers&#xa;admission_closed&#xa;(SendDrainGate.closeAdmission(), exactly once, global)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="180" y="640" width="472" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="fork1c" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="320" y="780" width="200" height="10" as="geometry"/>
        </mxCell>
        <mxCell id="grpc_zero" value="gRPC: wait accepted_inflight_zero&#xa;(grpcOpenSendRpcs == 0)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="90" y="830" width="304" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="rmt_zero" value="Remoting: wait accepted_inflight_zero&#xa;(remotingPendingWrites == 0)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="420" y="830" width="336" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="join1c" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="320" y="940" width="200" height="10" as="geometry"/>
        </mxCell>
        <mxCell id="deadline1" value="all terminals reached before&#xa;effective deadline?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="300" y="980" width="236" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="drained1" value="DRAINED" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="190" y="1100" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="force1" value="FORCE_DRAINING&#xa;(forced close, drain marked failed)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="390" y="1100" width="320" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="stop1" value="stop" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="370" y="1200" width="100" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="note1_1" value="Gate remains OPEN across the whole migration phase.&#xa;Neither protocol waits for the other to start." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;" vertex="1" parent="1">
          <mxGeometry x="370" y="80" width="397" height="70" as="geometry"/>
