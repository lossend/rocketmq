        <mxCell id="notready5" value="stay NotReady,&#xa;backoff + retry&#xa;until proxyWarmupTimeoutSeconds" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
