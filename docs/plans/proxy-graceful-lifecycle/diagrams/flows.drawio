  <diagram id="fl7" name="Rollout / rollback flow (spec §6)">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="start7" value="start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="240" y="0" width="100" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="canary7" value="Canary release,&#xa;lifecycle enabled,&#xa;real 5.0.7 / 5.2.1 / 5.3.2 clients,&#xa;real provider 8082 health check,&#xa;single Pod delete verified" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="130" y="80" width="320" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="prescale7" value="Pre-scale main cluster&#xa;(capacity inequality, not a magic&#xa;replica count) + confirm no live HPA" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="130" y="240" width="328" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="bootstrap7" value="One annotation-driven&#xa;bootstrap rollout&#xa;(binary + enableProxyAdminServer=true,&#xa;compressed into a single lossy rollout)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="120" y="370" width="352" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="verify87" value="Verify 8082 reachable&#xa;on every existing target" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="180" y="510" width="232" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="healthy7" value="all targets healthy on 8082?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="180" y="620" width="236" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="enablestrict7" value="Explicitly enable lifecycle=true&#xa;in production values,&#xa;switch HTTP probes / PreStop /&#xa;derived budgets / NLB health check" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="0" y="740" width="312" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="stopenable7" value="Stop - do not proceed&#xa;to strict enablement" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="330" y="760" width="208" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="stopA7" value="stop" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="380" y="900" width="100" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="waitcycle7" value="Wait at least one full&#xa;max-lease + grace cycle" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="880" width="224" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="metrics7" value="forced / timeout / late-connection&#xa;metrics show zero increase?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="20" y="1020" width="278" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="enableslo7" value="Enable strict SLO,&#xa;resume normal controlled rollout" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="10" y="1180" width="296" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="pauseinvestigate7" value="Pause rollout,&#xa;keep existing READY Pods,&#xa;investigate before retry" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="320" y="1170" width="240" height="90" as="geometry"/>
