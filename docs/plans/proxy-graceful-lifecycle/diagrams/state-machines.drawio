  <diagram id="sm5" name="GrpcActiveCall (spec §9.2) - non-unary drain lifecycle">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="init5" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="0" y="120" width="30" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="OPEN5" value="OPEN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="190" y="110" width="140" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="INTENT" value="CLOSE_INTENT_SENT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="600" y="50" width="176" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="TERM5" value="TERMINAL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="920" y="110" width="140" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="note10" value="Close intent only blocks further outbound writes.&#xa;The call stays registered - open count is NOT&#xa;decremented here." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;" vertex="1" parent="1">
          <mxGeometry x="70" y="0" width="383" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="note11" value="Only the wrapped listener's onComplete/onCancel is&#xa;canonical terminal. ServerCall.close() returning is&#xa;NOT proof of terminal." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;" vertex="1" parent="1">
          <mxGeometry x="480" y="160" width="397" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="e0" value="" style="html=1;rounded=0;" edge="1" parent="1" source="init5" target="OPEN5">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="30" y="130"/><mxPoint x="180" y="130"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e1" value="closeAll(policy)&#xa;Telemetry -&gt; Status.OK&#xa;other streaming -&gt; UNAVAILABLE" style="html=1;rounded=0;" edge="1" parent="1" source="OPEN5" target="INTENT">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="260" y="100"/><mxPoint x="260" y="100"/><mxPoint x="260" y="100"/><mxPoint x="260" y="100"/><mxPoint x="580" y="100"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e2" value="wrapped listener&#xa;onComplete() / onCancel()" style="html=1;rounded=0;" edge="1" parent="1" source="INTENT" target="TERM5">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="860" y="80"/><mxPoint x="990" y="80"/><mxPoint x="990" y="80"/><mxPoint x="990" y="80"/><mxPoint x="990" y="100"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e3" value="wrapped listener&#xa;onComplete() / onCancel()&#xa;(no drain close involved)" style="html=1;rounded=0;" edge="1" parent="1" source="OPEN5" target="TERM5">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="330" y="120"/><mxPoint x="910" y="120"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e4" value="" style="html=1;endArrow=none;dashed=1;strokeColor=#d6b656;" edge="1" parent="1" source="note10" target="INTENT">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="450" y="70"/><mxPoint x="580" y="70"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e5" value="" style="html=1;endArrow=none;dashed=1;strokeColor=#d6b656;" edge="1" parent="1" source="note11" target="TERM5">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="830" y="150"/><mxPoint x="830" y="140"/><mxPoint x="830" y="140"/><mxPoint x="830" y="140"/><mxPoint x="910" y="140"/></Array></mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="sm6" name="RequestTask (spec §9.3)">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="init6" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="170" y="20" width="30" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="CREATED" value="CREATED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="410" y="50" width="140" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="RUNNING" value="RUNNING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="590" y="20" width="140" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="STOPPED6" value="STOPPED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="590" y="90" width="140" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="note12" value="Only one of run()/stop() can win the CAS from&#xa;CREATED. Whichever loses must not re-attempt the&#xa;transition or double-report state." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;" vertex="1" parent="1">
          <mxGeometry x="0" y="70" width="376" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="e0" value="" style="html=1;rounded=0;" edge="1" parent="1" source="init6" target="CREATED">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="190" y="60"/><mxPoint x="190" y="60"/><mxPoint x="190" y="60"/><mxPoint x="190" y="60"/><mxPoint x="400" y="60"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e1" value="run()&#xa;CAS CREATED -&gt; RUNNING wins&#xa;(installs scope, calls taskStarted())" style="html=1;rounded=0;" edge="1" parent="1" source="CREATED" target="RUNNING">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="550" y="60"/><mxPoint x="580" y="60"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e2" value="stop(reason)&#xa;CAS CREATED -&gt; STOPPED wins&#xa;(writes taskSkipped(reason))" style="html=1;rounded=0;" edge="1" parent="1" source="CREATED" target="STOPPED6">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="550" y="90"/><mxPoint x="580" y="90"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e3" value="stop(reason) called&#xa;after RUNNING - CAS fails,&#xa;no-op (task already dispatched)" style="html=1;rounded=0;" edge="1" parent="1" source="RUNNING" target="RUNNING">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="580" y="60"/><mxPoint x="570" y="60"/><mxPoint x="570" y="60"/><mxPoint x="570" y="60"/><mxPoint x="570" y="80"/><mxPoint x="570" y="80"/><mxPoint x="570" y="80"/><mxPoint x="750" y="80"/><mxPoint x="750" y="80"/><mxPoint x="750" y="80"/><mxPoint x="750" y="40"/><mxPoint x="750" y="40"/><mxPoint x="750" y="40"/><mxPoint x="740" y="40"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e4" value="" style="html=1;endArrow=none;dashed=1;strokeColor=#d6b656;" edge="1" parent="1" source="note12" target="CREATED">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="380" y="90"/><mxPoint x="400" y="90"/></Array></mxGeometry>
        </mxCell>
